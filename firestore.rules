/**
 * @file Overview
 * This ruleset enforces a strict user-ownership model for most data, with the exception of WeatherForecasts, which are publicly readable.
 *
 * Data Structure:
 * - User profiles are stored under `/users/{userId}`.
 * - User-generated content (reports, recommendations, predictions) are stored under `/users/{userId}/...`.
 * - Weather forecasts are stored under `/weatherForecasts/{weatherForecastId}`.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profiles and associated data.
 * - Public listing of user profiles is disallowed.
 * - Weather forecasts are publicly readable.
 * - No schema validation is performed beyond what is necessary for authorization.
 *
 * Denormalization for Authorization:
 * - User-specific data is nested under the user's UID, enabling path-based authorization. This avoids the need for `get()` calls to verify ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with UID 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1' can create their own profile.
     * @deny (create) User with UID 'anotherUser' cannot create a profile for 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1'.
     * @allow (get, update, delete) User with UID 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1' can get, update, and delete their own profile.
     * @deny (get, update, delete) User with UID 'anotherUser' cannot get, update, or delete the profile for 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to crop disease reports.
     * @path /users/{userId}/reports/{reportId}
     * @allow (create) User with UID 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1' can create a report under their own profile.
     * @deny (create) User with UID 'anotherUser' cannot create a report under the profile for 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1'.
     * @allow (get, update, delete) User with UID 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1' can get, update, and delete their own report.
     * @deny (get, update, delete) User with UID 'anotherUser' cannot get, update, or delete the report under the profile for 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/reports/{reportId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to soil nutrient reports.
     * @path /users/{userId}/soilReports/{soilReportId}
     * @allow (create) User with UID 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1' can create a soil report under their own profile.
     * @deny (create) User with UID 'anotherUser' cannot create a soil report under the profile for 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1'.
     * @allow (get, update, delete) User with UID 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1' can get, update, and delete their own soil report.
     * @deny (get, update, delete) User with UID 'anotherUser' cannot get, update, or delete the soil report under the profile for 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/soilReports/{soilReportId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to crop recommendations.
     * @path /users/{userId}/cropRecommendations/{cropRecommendationId}
     * @allow (create) User with UID 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1' can create a crop recommendation under their own profile.
     * @deny (create) User with UID 'anotherUser' cannot create a crop recommendation under the profile for 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1'.
     * @allow (get, update, delete) User with UID 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1' can get, update, and delete their own crop recommendation.
     * @deny (get, update, delete) User with UID 'anotherUser' cannot get, update, or delete the crop recommendation under the profile for 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/cropRecommendations/{cropRecommendationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to weather forecast data.
     * @path /weatherForecasts/{weatherForecastId}
     * @allow (get, list) Any user can read weather forecast data.
     * @deny (create, update, delete) No user can create, update, or delete weather forecast data.
     * @principle Allows public read access but restricts write access.
     */
    match /weatherForecasts/{weatherForecastId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to yield predictions.
     * @path /users/{userId}/yieldPredictions/{yieldPredictionId}
     * @allow (create) User with UID 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1' can create a yield prediction under their own profile.
     * @deny (create) User with UID 'anotherUser' cannot create a yield prediction under the profile for 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1'.
     * @allow (get, update, delete) User with UID 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1' can get, update, and delete their own yield prediction.
     * @deny (get, update, delete) User with UID 'anotherUser' cannot get, update, or delete the yield prediction under the profile for 'iyOgJe9jgAeXv9rcqHlNaPnDuAl1'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/yieldPredictions/{yieldPredictionId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}